APP_PORT=4010
NODE_ENV=development
REFRESH_CRON=0 */30 * * * *
APP_BASE_DIR=
DATA_DIRECTORY=

TENANT_ID=your-entra-tenant-id
CLIENT_ID=your-app-registration-client-id
CLIENT_SECRET=your-app-registration-client-secret

DEFENDER_API_BASE_URL=https://api.security.microsoft.com
DEFENDER_SCOPE=https://api.security.microsoft.com/.default
DEFENDER_INITIATIVES_PATH=/api/exposure/v1/initiatives
DEFENDER_TOP_INITIATIVES_PATH=/api/exposure/v1/topInitiatives
DEFENDER_VULNERABILITY_OVERVIEW_PATH=/api/exposure/v1/overview
DEFENDER_CLOUD_SCORE_PATH=/api/exposure/v1/secureScores

GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_SECURE_SCORES_PATH=/security/secureScores?$top=1

MCP_BRIDGE_URL=http://localhost:5055
MCP_BRIDGE_API_KEY=

POWERBI_PUSH_DATASET_URL=
POWERBI_PUSH_BEARER_TOKEN=

PII_MASKING_SALT=change-me
RETENTION_YEARS=7
ENFORCE_US_RESIDENCY=true

AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=healthhub-audit
AZURE_BLOB_REGION=eastus

APPROVAL_TTL_MINUTES=60
TEAMS_APPROVAL_WEBHOOK_URL=
REQUIRE_SENSITIVE_APPROVAL=true

SENTINEL_BIDIRECTIONAL_ENABLED=false
SENTINEL_INBOUND_SECRET=
SENTINEL_OUTBOUND_WEBHOOK_URL=

HARNESS_MAX_LOOP_ITERATIONS=2
HARNESS_MAX_EXTERNAL_CALLS=20
HARNESS_EXECUTION_TIMEOUT_MS=120000
HARNESS_TOKEN_BUDGET=500000
